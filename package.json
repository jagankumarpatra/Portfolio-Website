{
  "name": "portfolio",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "clean": "rimraf .next",
    "prestart": "npm run clean && npm run build",
    "dev": "next dev",
    "build": "npm run check:content && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:content && npm test",
    "test": "vitest run",
    "preview": "npm run check:content && cross-env SHOW_DRAFTS=true next build && cross-env SHOW_DRAFTS=true next start"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@vercel/analytics": "2.0.1",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.59.0",
    "next": "15.5.28",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "rimraf": "6.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "jsdom": "30.1.3",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=20"
  }
}